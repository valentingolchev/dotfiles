#!/usr/bin/env bash
set -e

KITTY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
THEMES_DIR="$KITTY_CONFIG/themes"

if [[ ! -d "$THEMES_DIR" ]]; then
  echo "No themes directory found at $THEMES_DIR" >&2
  exit 1
fi

themes=$(find "$THEMES_DIR" -name '*-light.conf' \
  | xargs -I{} basename {} \
  | sed 's/-light\.conf$//' \
  | sort)

if [[ -z "$themes" ]]; then
  echo "No themes found in $THEMES_DIR" >&2
  exit 1
fi

selected=$(echo "$themes" | fzf --prompt="Kitty theme: " --height=~50%)

[[ -z "$selected" ]] && exit 0

light_src="$THEMES_DIR/${selected}-light.conf"
dark_src="$THEMES_DIR/${selected}-dark.conf"

[[ ! -f "$light_src" ]] && { echo "Missing: $light_src" >&2; exit 1; }
[[ ! -f "$dark_src"  ]] && { echo "Missing: $dark_src"  >&2; exit 1; }

cp "$light_src" "$KITTY_CONFIG/light-theme.auto.conf"
cp "$dark_src"  "$KITTY_CONFIG/dark-theme.auto.conf"

# Update the theme name comment inside BEGIN/END_KITTY_THEME markers
theme_name=$(grep '^## name:' "$light_src" | head -1 | sed 's/^## name: *//' | sed 's/ Light$//')
kitty_conf="$KITTY_CONFIG/kitty.conf"
sed -i "/# BEGIN_KITTY_THEME/{n; s/.*/# $theme_name/}" "$kitty_conf"

pkill -USR1 kitty 2>/dev/null || true

echo "Switched to: $selected"
