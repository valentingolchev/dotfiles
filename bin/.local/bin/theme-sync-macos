#!/bin/sh
# theme-sync-macos — launchd (StartInterval=60): sync tinty+foot to macOS appearance.
# Delegates to theme-hook (override via theme-defaults wins; defaults match home.nix darkman hooks).
LOCK="${TMPDIR:-/tmp}/theme-sync-macos.lock"
[ -f "$LOCK" ] && exit 0
trap 'rm -f "$LOCK"' EXIT
touch "$LOCK"

os=dark
defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q Dark || os=light
cur=$(tinty current variant 2>/dev/null)
[ "$os" = "$cur" ] && exit 0

if [ "$os" = dark ]; then
    exec "$HOME/.local/bin/theme-hook" dark base16-kanagawa-dragon
else
    exec "$HOME/.local/bin/theme-hook" light base16-kanagawa
fi
